# Shared local-development baseline for the Project 02 team.
# Copy this file to .env. Coordinate changes to image, database credentials,
# sample-data behavior, or timezone so every member keeps the same baseline.
# These credentials are only for local classroom development.

# Pin one SQL Server build so every team member runs the same database engine.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU27-ubuntu-22.04

MSSQL_SA_PASSWORD=LibraryAdmin_2026!
APP_DB_USER=library_app
APP_DB_PASSWORD=LibraryApp_2026!

# MSSQL_PORT is the host port. Change it locally only if port 1433 is occupied.
MSSQL_PORT=1433
LOAD_SAMPLE_DATA=true
TZ=Asia/Ho_Chi_Minh

# SQL Server's Linux image is x86-64. Apple Silicon uses Docker emulation.
DOCKER_PLATFORM=linux/amd64
